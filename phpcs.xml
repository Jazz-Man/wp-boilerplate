<?xml version="1.0"?>
<ruleset name="Roots" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
  <description>Roots Coding Standards</description>

  <!-- Scan all files in directory -->
  <file>.</file>

  <!-- Scan only PHP files -->
  <arg name="extensions" value="php"/>

  <!-- Ignore WordPress and Composer dependencies -->
  <exclude-pattern>\.github/*</exclude-pattern>
  <exclude-pattern>/copy-block-styles.js</exclude-pattern>
  <exclude-pattern>/webpack*.js</exclude-pattern>
  <exclude-pattern>\.idea/*</exclude-pattern>
  <exclude-pattern>/config/*</exclude-pattern>
  <exclude-pattern>web/wp</exclude-pattern>
  <exclude-pattern>/vendor/*</exclude-pattern>
  <exclude-pattern>/wp-cli/*</exclude-pattern>
  <exclude-pattern>/node_modules/*</exclude-pattern>
  <exclude-pattern>/web/app/mu-plugins/*</exclude-pattern>
  <exclude-pattern>/web/app/plugins/*</exclude-pattern>
  <exclude-pattern>/web/app/themes/boilerplate/test/*</exclude-pattern>
  <exclude-pattern>/web/app/themes/boilerplate/dist/*</exclude-pattern>

  <config name="testVersion" value="8.2-"/>
  <config name="minimum_supported_wp_version" value="8.0"/>

  <!-- Show colors in console -->
  <arg value="-colors"/>

  <arg name="parallel" value="100"/>

  <!-- Scan only PHP files -->
  <arg name="extensions" value="php"/>

  <arg name="cache" value=".phpcs.cache"/>

  <!-- Show sniff codes in all reports -->
  <arg value="nps"/>

  <rule ref="WordPress">
    <!-- PSR4 -->
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
    <exclude name="WordPress.WP.I18n"/>
  </rule>

  <rule ref="PHPCompatibility"/>

  <rule ref="Generic.Metrics.NestingLevel">
    <properties>
      <property name="absoluteNestingLevel" value="3"/>
    </properties>
  </rule>

  <!-- Allow short array syntax -->
  <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
    <severity>0</severity>
  </rule>
  <rule ref="Generic.Arrays.DisallowLongArraySyntax.Found"/>

</ruleset>
