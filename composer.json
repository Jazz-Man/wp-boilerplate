{
  "authors": [
    {
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw",
      "name": "Scott Walkinshaw"
    },
    {
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs",
      "name": "Ben Word"
    },
    {
      "email": "vsokolyk@gmail.com",
      "homepage": "https://github.com/Jazz-Man",
      "name": "Vasyl Sokolyk"
    }
  ],
  "autoload": {
    "files": ["web/app/themes/boilerplate/includes/helper.php"],
    "psr-4": {
      "JazzMan\\Themes\\": "web/app/themes/boilerplate/includes"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true
    },
    "apcu-autoloader": true,
    "classmap-authoritative": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "description": "WordPress boilerplate with modern development tools, easier configuration, and an improved folder structure",
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  },
  "homepage": "https://roots.io/bedrock/",
  "keywords": ["bedrock", "composer", "roots", "wordpress", "wp", "wp-config"],
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "jazzman/wp-boilerplate",
  "prefer-stable": true,
  "repositories": [
    {
      "only": ["wpackagist-plugin/*", "wpackagist-theme/*"],
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "jazzman/custom-post-type": "^3.3",
    "jazzman/php-robots": "^2.0",
    "jazzman/wp-app-config": "^2.3",
    "jazzman/wp-duplicate-post": "^1.1",
    "jazzman/wp-mail": "^2.0",
    "jazzman/wp-nav-menu-cache": "^0.3.0",
    "jazzman/wp-password-argon": "^0.1.0",
    "jazzman/wp-performance": "^3.6",
    "oscarotero/env": "^2.1",
    "php": "^8.2",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^6.9",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "jazzman/php-cs-fixer-rules": "^0.2.1",
    "phpcompatibility/php-compatibility": "^9.3",
    "roave/security-advisories": "@dev",
    "symfony/var-dumper": "^6.4",
    "wp-coding-standards/wpcs": "^3.0",
    "wpackagist-plugin/wordpress-importer": "^0.8.2"
  },
  "scripts": {
    "clearNodeModules": "rm -rf node_modules",
    "deploy": [
      "@clearNodeModules",
      "npm install",
      "npm run production",
      "@clearNodeModules"
    ],
    "post-root-package-install": ["php -r \"copy('.env.example', '.env');\""]
  },
  "support": {
    "forum": "https://discourse.roots.io/category/bedrock",
    "issues": "https://github.com/roots/bedrock/issues"
  },
  "type": "project"
}
